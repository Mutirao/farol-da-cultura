{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "root": true,
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main"
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!docs/PLANO-FASE-0-REVISADO.md",
      "!docs/PLANO-EXECUCAO.md",
      "!.claude/hooks/tests/fixtures",
      "!tooling/biome-plugins/fixtures",
      "!.agents/skills",
      "!skills-lock.json"
    ]
  },
  "plugins": [
    {
      "path": "./tooling/biome-plugins/no-hex-color.grit",
      "includes": ["**", "!packages/tokens/**"]
    },
    {
      "path": "./tooling/biome-plugins/no-jsx-literal-text.grit",
      "includes": ["apps/**"]
    }
  ],
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "assist": {
    "enabled": true
  }
}
