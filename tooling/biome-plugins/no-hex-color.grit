// Cor hex literal fora de packages/tokens/** é erro: cores vêm de @farol/tokens.
// Escopo (includes) definido em biome.json.
language js

or {
  JsStringLiteralExpression() as $lit where {
    $lit <: r"^[\"'](?i)#(?:[0-9a-f]{3}|[0-9a-f]{4}|[0-9a-f]{6}|[0-9a-f]{8})[\"']$"
  },
  JsTemplateChunkElement() as $lit where {
    $lit <: r"(?s)(?:.*[^\w&])?#(?:[0-9a-fA-F]{8}|[0-9a-fA-F]{6}|[0-9a-fA-F]{3,4})(?:[^\w].*)?"
  }
} where {
  not $absolute_filename <: r".*/packages/tokens/.*",
  register_diagnostic(span=$lit, message="Cor hex literal fora de packages/tokens: use um token de @farol/tokens.", severity="error")
}
