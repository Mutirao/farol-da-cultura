{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [
    "biome.json",
    "pnpm-workspace.yaml",
    "packages/tsconfig/*.json",
    ".nvmrc"
  ],
  "tasks": {
    "lint": {},
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    }
  }
}
